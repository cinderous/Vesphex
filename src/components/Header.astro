---
import { site } from '../config/site';
import { nav } from '../data/nav';
import WaspMark from './WaspMark.astro';
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <WaspMark size={26} />
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {nav.map((item) => (
        <a class="nav-desktop__link" href={item.href}>
          <span class="nav-desktop__idx">{item.index}</span>
          {item.label}
        </a>
      ))}
    </nav>

    <p class="header-status" aria-label={`System status ${site.system.status}`}>
      <span class="status-dot status-dot--live" aria-hidden="true"></span>
      <span>{site.system.status}</span>
    </p>

    <details class="nav-mobile" data-nav>
      <summary class="nav-mobile__toggle">
        <span class="nav-mobile__icon" aria-hidden="true"></span>
        <span class="visually-hidden">Open navigation</span>
      </summary>
      <div class="nav-mobile__panel">
        <p class="meta">Channel / public</p>
        <nav aria-label="Mobile">
          {nav.map((item) => (
            <a href={item.href}>
              <span>{item.index}</span>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll('[data-nav] a').forEach((link) => {
    link.addEventListener('click', () => {
      const drawer = link.closest('details');
      if (drawer) drawer.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-h);
    border-bottom: 1px solid var(--line);
    background: rgba(7, 7, 6, 0.94);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--paper);
  }

  .brand__name {
    font-size: 0.98rem;
    font-weight: 550;
    letter-spacing: 0.18em;
  }

  .nav-desktop {
    display: none;
    flex: 1;
    justify-content: center;
    gap: 0.15rem;
  }

  .nav-desktop__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.45rem 0.55rem;
    color: var(--fog);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-desktop__link:hover {
    color: var(--paper);
  }

  .nav-desktop__idx {
    color: var(--amber-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .header-status {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0 auto;
    color: var(--fog);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
  }

  .nav-mobile {
    margin-left: auto;
  }

  .nav-mobile__toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-mid);
    list-style: none;
    cursor: pointer;
  }

  .nav-mobile__toggle::-webkit-details-marker {
    display: none;
  }

  .nav-mobile__icon,
  .nav-mobile__icon::before,
  .nav-mobile__icon::after {
    display: block;
    width: 1rem;
    height: 1px;
    background: var(--paper);
  }

  .nav-mobile__icon {
    position: relative;
  }

  .nav-mobile__icon::before,
  .nav-mobile__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-mobile__icon::before {
    top: -5px;
  }

  .nav-mobile__icon::after {
    top: 5px;
  }

  .nav-mobile__panel {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    padding: 1.5rem var(--gutter) 2rem;
    background: #0b0b0a;
    border-top: 1px solid var(--line);
  }

  .nav-mobile__panel nav {
    display: grid;
    margin-top: 1rem;
  }

  .nav-mobile__panel a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--paper);
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-mobile__panel a span {
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 980px) {
    .nav-desktop,
    .header-status {
      display: flex;
    }

    .nav-mobile {
      display: none;
    }
  }
</style>
