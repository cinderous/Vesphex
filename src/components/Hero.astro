---
import { site } from '../config/site';
import HeroVisual from './HeroVisual.astro';

const identity = site.identity.join('  ·  ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="wrap hero__layout">
    <div class="hero__copy">
      <p class="kicker">Public channel</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="hero__identity">{identity}</p>
      <p class="hero__tagline">{site.tagline}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#operator">Enter the system</a>
        <a class="btn btn--ghost" href="#lab">View the work</a>
      </div>
      <dl class="system-board">
        <div>
          <dt>System</dt>
          <dd>{site.system.name}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd class="is-live">
            <span class="status-dot status-dot--live" aria-hidden="true"></span>
            {site.system.status}
          </dd>
        </div>
        <div>
          <dt>Node</dt>
          <dd>{site.system.node}</dd>
        </div>
        <div>
          <dt>Mode</dt>
          <dd>{site.system.mode}</dd>
        </div>
      </dl>
    </div>
    <div class="hero__mark">
      <HeroVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(36rem, calc(100svh - var(--header-h)), 48rem);
    display: grid;
    align-items: center;
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3rem, 8vw, 5.5rem);
    overflow: hidden;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse at 70% 40%, black 20%, transparent 72%);
  }

  .hero__layout {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.1rem, 8vw, 7.2rem);
    font-weight: 560;
    letter-spacing: 0.06em;
    line-height: 0.9;
  }

  .hero__identity {
    margin: 1rem 0 0;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__tagline {
    max-width: 34rem;
    margin: 1.4rem 0 0;
    color: var(--fog);
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.28rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .system-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.25rem;
    max-width: 26rem;
    margin: 2.4rem 0 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line-mid);
    background: rgba(11, 11, 10, 0.55);
  }

  .system-board dt {
    margin: 0 0 0.25rem;
    color: var(--dust);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .system-board dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .is-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--amber-hot);
  }

  .hero__mark {
    display: grid;
    justify-items: center;
  }

  @media (min-width: 980px) {
    .hero__layout {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 34rem);
      gap: 3rem;
    }

    .system-board {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 979px) {
    .hero__mark {
      order: -1;
    }

    .hero__mark :global(.hero-visual) {
      max-height: min(46vh, 22rem);
      width: auto;
    }
  }
</style>
