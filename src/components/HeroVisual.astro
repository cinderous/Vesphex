<style>
  .hero-visual {
    width: min(100%, 34rem);
    height: auto;
    overflow: visible;
  }

  .flow,
  .broken {
    stroke-opacity: 0.42;
    stroke-dasharray: 7 9;
    animation: circuit-flow 16s linear infinite;
  }

  .flow.delay,
  .broken.delay,
  .ember.delay {
    animation-delay: -4s;
  }

  .vein,
  .trace {
    fill: none;
    stroke: #d4b44a;
    stroke-opacity: 0.7;
    stroke-width: 1.05;
  }

  .vein.faint {
    stroke-opacity: 0.4;
  }

  .trace {
    stroke-dasharray: 3 5;
    animation: dash-move 8s linear infinite;
  }

  .antenna,
  .leg {
    fill: none;
    stroke: #d2cbb8;
    stroke-width: 1.7;
    stroke-linejoin: bevel;
    stroke-linecap: square;
  }

  .scar {
    fill: none;
    stroke: #8a4e2c;
    stroke-width: 1.2;
  }

  .stinger {
    fill: #c9a227;
  }

  .core {
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 5.5s ease-in-out infinite;
  }

  .ember {
    animation: ember 3.6s ease-in-out infinite;
  }

  .particle {
    animation: drift 7s ease-in-out infinite;
  }

  .particle.d2 { animation-delay: -1.2s; }
  .particle.d3 { animation-delay: -2.1s; }
  .particle.d4 { animation-delay: -3s; }
  .particle.d5 { animation-delay: -4.2s; }
  .particle.d6 { animation-delay: -5s; }

  .wing {
    transform-box: fill-box;
  }

  .wing--l {
    transform-origin: 100% 40%;
    animation: wing-l 6.5s ease-in-out infinite;
  }

  .wing--r {
    transform-origin: 0% 40%;
    animation: wing-r 6.5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .broken,
    .core,
    .ember,
    .particle,
    .wing--l,
    .wing--r,
    .trace {
      animation: none;
    }
  }
</style>
