---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card frame">
  <span class="frame-b" aria-hidden="true"></span>
  <header class="card__meta">
    <p class="meta">{project.category}</p>
    <p class="card__status">
      <span class="status-dot" aria-hidden="true"></span>
      {project.status}
    </p>
  </header>
  <h3>{project.name}</h3>
  <p>{project.summary}</p>
  <ul>
    {project.tags.map((tag) => (
      <li class="tag">{tag}</li>
    ))}
  </ul>
  <a class="btn btn--ghost" href={`/lab/${project.slug}`}>Explore</a>
</article>

<style>
  .card {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.35rem 1.25rem 1.3rem;
    border: 1px solid var(--line);
    background: rgba(11, 11, 10, 0.72);
    transition: border-color 180ms var(--ease);
  }

  .card:hover {
    border-color: var(--amber-deep);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--amber-soft);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    line-height: 1.25;
  }

  p {
    margin: 0;
    color: var(--fog);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .btn {
    justify-self: start;
    margin-top: 0.4rem;
  }
</style>
