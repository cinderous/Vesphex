---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const title = `${project.name} — ${site.name}`;
const description = project.summary;
---

<BaseLayout title={title} description={description} path={`/lab/${project.slug}`}>
  <article class="project">
    <div class="wrap">
      <p class="kicker"><a href="/#lab">02 Lab</a> / Node</p>
      <p class="meta-row">
        <span class="meta">{project.category}</span>
        <span class="status">
          <span class="status-dot" aria-hidden="true"></span>
          {project.status}
        </span>
      </p>
      <h1>{project.name}</h1>
      <p class="summary">{project.summary}</p>
      <p class="body">{project.description}</p>
      <ul>
        {project.tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
      <p class="actions">
        <a class="btn btn--primary" href="/#lab">Return to lab</a>
        <a class="btn btn--ghost" href="/#connect">Establish connection</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    min-height: calc(100svh - 16rem);
  }

  .kicker a {
    color: inherit;
    text-decoration: none;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 1rem;
    max-width: 16ch;
    font-size: clamp(2.1rem, 1.4rem + 3vw, 4rem);
    letter-spacing: 0.04em;
    line-height: 1.05;
  }

  .summary,
  .body {
    max-width: 40rem;
    color: var(--fog);
  }

  .summary {
    font-size: 1.15rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }
</style>
